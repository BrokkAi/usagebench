{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BrokkAi/usagebench/schema/evaluation-protocol.schema.json",
  "title": "UsageBench Evaluation Protocol",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "freezeId", "targetProfiles", "population", "sampling", "operations", "claimScope"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "freezeId": { "type": "string", "minLength": 1 },
    "targetProfiles": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language", "candidateId", "profile"],
        "properties": {
          "language": { "type": "string", "minLength": 1 },
          "candidateId": { "type": "string", "minLength": 1 },
          "profile": { "type": "string", "minLength": 1 }
        }
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "eligibility", "exclusions"],
      "properties": {
        "snapshot": { "type": "string", "minLength": 1 },
        "eligibility": { "type": "string", "minLength": 1 },
        "exclusions": { "type": "string", "minLength": 1 }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seedDerivation", "repositoriesPerProfile", "declarationsPerRepository", "replacementRule"],
      "properties": {
        "seedDerivation": { "type": "string", "minLength": 1 },
        "repositoriesPerProfile": { "type": "integer", "minimum": 1 },
        "declarationsPerRepository": { "type": "integer", "minimum": 1 },
        "replacementRule": { "type": "string", "minLength": 1 }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["references", "declaration", "definition", "type_definition"] }
    },
    "claimScope": { "type": "string", "minLength": 1 }
  }
}
