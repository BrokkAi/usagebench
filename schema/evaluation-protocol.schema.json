{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BrokkAi/usagebench/schema/evaluation-protocol.schema.json",
  "title": "UsageBench Evaluation Protocol",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "freezeId", "targetProfiles", "population", "sampling", "operations", "claimScope"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "freezeId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "targetProfiles": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language", "candidateId", "profile"],
        "properties": {
          "language": { "type": "string", "minLength": 1 },
          "candidateId": { "type": "string", "minLength": 1 },
          "profile": { "type": "string", "minLength": 1 },
          "githubLanguage": { "type": "string", "minLength": 1 },
          "rootBuildMarkers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "sourceExtensions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9.]+$" }
          },
          "excludedFileSuffixes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "eligibility", "exclusions", "minimumStars"],
      "properties": {
        "snapshot": { "type": "string", "minLength": 1 },
        "eligibility": { "type": "string", "minLength": 1 },
        "exclusions": { "type": "string", "minLength": 1 },
        "minimumStars": { "type": "integer", "minimum": 1 },
        "minimumSourceFiles": { "type": "integer", "minimum": 1 },
        "maximumRepositorySizeBytes": { "type": "integer", "minimum": 1 },
        "excludedPathComponents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "priorSelections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifactLink" }
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seedDerivation", "repositoriesPerProfile", "declarationsPerRepository", "replacementRule"],
      "properties": {
        "seedDerivation": { "type": "string", "minLength": 1 },
        "repositoriesPerProfile": { "type": "integer", "minimum": 1 },
        "declarationsPerRepository": { "type": "integer", "minimum": 1 },
        "minimumReplacementRepositories": { "type": "integer", "minimum": 1 },
        "replacementRule": { "type": "string", "minLength": 1 }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["references", "declaration", "definition", "type_definition"] }
    },
    "reviewEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumIndependentReviewers", "adjudicationRequired", "sourceOnly", "analyzerBlind"],
      "properties": {
        "minimumIndependentReviewers": { "type": "integer", "minimum": 2 },
        "adjudicationRequired": { "const": true },
        "sourceOnly": { "const": true },
        "analyzerBlind": { "const": true }
      }
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["separateSliceDenominators", "combinedAggregation"],
      "properties": {
        "separateSliceDenominators": { "const": true },
        "combinedAggregation": { "const": "stratified-only" }
      }
    },
    "claimScope": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": 2 } } },
      "then": {
        "required": ["reviewEvidence", "reporting"],
        "properties": {
          "targetProfiles": {
            "items": {
              "required": ["language", "candidateId", "profile", "githubLanguage", "rootBuildMarkers", "sourceExtensions", "excludedFileSuffixes"]
            }
          },
          "population": {
            "required": ["snapshot", "eligibility", "exclusions", "minimumStars", "minimumSourceFiles", "maximumRepositorySizeBytes", "excludedPathComponents", "priorSelections"]
          },
          "sampling": {
            "required": ["seedDerivation", "repositoriesPerProfile", "declarationsPerRepository", "minimumReplacementRepositories", "replacementRule"]
          }
        }
      }
    }
  ],
  "$defs": {
    "artifactLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
