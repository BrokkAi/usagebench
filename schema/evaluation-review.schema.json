{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BrokkAi/usagebench/schema/evaluation-review.schema.json",
  "title": "UsageBench Evaluation Review Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "freezeId", "selection", "reviewers", "adjudication"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "freezeId": { "type": "string", "minLength": 1 },
    "selection": { "$ref": "#/$defs/artifactLink" },
    "reviewTier": {
      "enum": ["agent_reviewed", "human_adjudicated_agent_panel", "independently_human_reviewed"]
    },
    "reviewProtocol": { "$ref": "#/$defs/artifactLink" },
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reviewArtifact" }
    },
    "adjudication": { "$ref": "#/$defs/reviewArtifact" }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": 2 } } },
      "then": {
        "required": ["reviewTier", "reviewProtocol"],
        "properties": {
          "reviewers": {
            "items": {
              "required": ["participant"]
            }
          },
          "adjudication": { "required": ["participant"] }
        }
      }
    }
  ],
  "$defs": {
    "artifactLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "reviewArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "participant": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["agent", "human"] },
            "provider": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 },
            "executionId": { "type": "string", "minLength": 1 },
            "executedAt": { "type": "string", "format": "date-time" },
            "identity": { "type": "string", "minLength": 1 },
            "attestation": { "type": "string", "minLength": 1 }
          }
        },
        "prompt": { "$ref": "#/$defs/artifactLink" },
        "responseSchema": { "$ref": "#/$defs/artifactLink" },
        "rawResponse": { "$ref": "#/$defs/artifactLink" }
      }
    }
  }
}
