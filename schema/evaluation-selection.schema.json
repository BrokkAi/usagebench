{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BrokkAi/usagebench/schema/evaluation-selection.schema.json",
  "title": "UsageBench Evaluation Selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "freezeId", "protocol", "documents"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "freezeId": { "type": "string", "minLength": 1 },
    "protocol": { "$ref": "#/$defs/artifactLink" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseFile", "language", "candidateId", "source", "caseIds"],
        "properties": {
          "caseFile": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "minLength": 1 },
          "candidateId": { "type": "string", "minLength": 1 },
          "source": { "$ref": "#/$defs/gitSource" },
          "caseIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "artifactLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "gitSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "commit"],
      "properties": {
        "repo": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    }
  }
}
