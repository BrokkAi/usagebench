{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BrokkAi/usagebench/schema/legacy-promotion-cohort.schema.json",
  "title": "UsageBench Pre-review Legacy Promotion Cohort",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cohortId", "selectionProvenance", "selectionBasis", "analyzerOutcomeUse", "policy", "generator", "sourceDocuments", "eligibleCounts", "balancedCorePerLanguage", "inventory"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "cohortId": { "type": "string", "minLength": 1 },
    "selectionProvenance": { "const": "retrospectively_selected" },
    "selectionBasis": { "const": "source_only" },
    "analyzerOutcomeUse": { "const": "forbidden" },
    "policy": { "$ref": "#/$defs/link" },
    "generator": { "$ref": "#/$defs/link" },
    "sourceDocuments": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sourceDocument" } },
    "eligibleCounts": { "type": "object", "minProperties": 11, "maxProperties": 11, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "balancedCorePerLanguage": { "type": "integer", "minimum": 0, "maximum": 10 },
    "inventory": { "type": "array", "minItems": 158, "maxItems": 158, "items": { "$ref": "#/$defs/row" } }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "link": { "type": "object", "additionalProperties": false, "required": ["file", "sha256"], "properties": { "file": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha" } } },
    "sourceDocument": { "type": "object", "additionalProperties": false, "required": ["file", "sha256"], "properties": { "file": { "type": "string", "pattern": "^benchmarks/cases/.+\\.yaml$" }, "sha256": { "$ref": "#/$defs/sha" } } },
    "position": { "type": "object", "additionalProperties": false, "required": ["line", "character"], "properties": { "line": { "type": "integer", "minimum": 0 }, "character": { "type": "integer", "minimum": 0 } } },
    "range": { "type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": { "start": { "$ref": "#/$defs/position" }, "end": { "$ref": "#/$defs/position" } } },
    "query": { "type": "object", "additionalProperties": false, "required": ["operation", "status", "uri", "range"], "properties": { "operation": { "type": "string", "minLength": 1 }, "status": { "enum": ["canonical", "compatible", "unsupported", "not_planned"] }, "uri": { "type": "string", "minLength": 1 }, "range": { "$ref": "#/$defs/range" } } },
    "counts": { "type": "object", "additionalProperties": false, "required": ["required", "optional", "unproven", "excluded"], "properties": { "required": { "type": "integer", "minimum": 0 }, "optional": { "type": "integer", "minimum": 0 }, "unproven": { "type": "integer", "minimum": 0 }, "excluded": { "type": "integer", "minimum": 0 } } },
    "review": { "type": "object", "additionalProperties": false, "required": ["method", "notesSha256"], "properties": { "method": { "type": "string", "minLength": 1 }, "notesSha256": { "$ref": "#/$defs/sha" } } },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["language", "document", "caseId", "sourceUri", "queries", "symbolKind", "semanticFeature", "sourceComplexity", "locationCounts", "fixtureDeterminism", "projectLoadEvidence", "exactRangeValidity", "duplicationGroup", "firstReviewProvenance", "decision", "selectionOrder"],
      "properties": {
        "language": { "type": "string", "minLength": 1 }, "document": { "type": "string", "minLength": 1 }, "caseId": { "type": "string", "minLength": 1 }, "sourceUri": { "type": "string", "minLength": 1 },
        "queries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/query" } }, "symbolKind": { "type": "string", "minLength": 1 }, "semanticFeature": { "type": "string", "minLength": 1 }, "sourceComplexity": { "type": "string", "minLength": 1 },
        "locationCounts": { "$ref": "#/$defs/counts" }, "fixtureDeterminism": { "const": "checked_in_fixture" }, "projectLoadEvidence": { "enum": ["project_file_present_not_executed", "source_only_not_executed"] }, "exactRangeValidity": { "const": "validated_against_fixture" },
        "duplicationGroup": { "type": "string", "pattern": "^dup-[0-9a-f]{16}$" }, "firstReviewProvenance": { "$ref": "#/$defs/review" },
        "decision": { "enum": ["balanced_core", "overflow", "control_unsupported", "control_not_planned"] }, "selectionOrder": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
