{
  "id": "apple-clangd-21",
  "name": "Apple clangd",
  "languages": ["cpp"],
  "requestedVersion": "21.0.0",
  "source": "https://developer.apple.com/xcode/",
  "command": ["clangd", "--background-index", "--clang-tidy=false"],
  "initializationOptions": {"clangdFileStatus": true},
  "fileExtensions": [".c", ".cc", ".cpp", ".cxx", ".h", ".hh", ".hpp", ".hxx"],
  "languageIds": {
    ".c": "c",
    ".cc": "cpp",
    ".cpp": "cpp",
    ".cxx": "cpp",
    ".h": "cpp",
    ".hh": "cpp",
    ".hpp": "cpp",
    ".hxx": "cpp"
  },
  "queryDeclaration": true,
  "workspaceFiles": {"compile_flags.txt": "-std=c++20\n-I.\n-Iinclude\n"},
  "documentOpenStrategy": "query_documents",
  "documentReadiness": {
    "notification": "textDocument/clangd.fileStatus",
    "readyState": "idle",
    "timeoutMilliseconds": 60000
  },
  "generateCompileCommands": true
}
