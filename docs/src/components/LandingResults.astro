---
// Results-first landing view. Every count and rate below is computed from the
// evidence map's derived scores for a published slice; only the short answer is
// hand-written. When a slice has no verified bundle the scores are absent, and
// the page reports readiness rather than inventing a number.
import evidence from '../data/evidence.json';

interface ProfileScore {
  reference: string;
  strict: { shared: number; bifrostExact: number; referenceExact: number };
  required: { shared: number; bifrostFound: number; referenceFound: number };
}

interface SliceResult {
  status: string;
  release?: string | null;
  revision?: string;
  derivedScores?: { profiles: ProfileScore[] };
}

const slices = evidence.slices as Record<string, any>;
const legacy = slices.legacy;
const legacyResult = (legacy?.result ?? {}) as SliceResult;
const published = legacyResult.status === 'published_immutable_release';
const profiles: ProfileScore[] = legacyResult.derivedScores?.profiles ?? [];

// A reference profile's registered name carries its version; the short name is
// what a reader scans for. Keyed on the profile string the result generator
// emits.
const shortNames: [RegExp, string][] = [
  [/^Apple clangd/, 'clangd'],
  [/^Eclipse JDT LS/, 'Eclipse JDT LS'],
  [/^gopls/, 'gopls'],
  [/^Intelephense/, 'Intelephense'],
  [/^Metals/, 'Metals'],
  [/^Pyright/, 'Pyright'],
  [/^Microsoft\.CodeAnalysis\.LanguageServer/, 'Roslyn'],
  [/^Ruby LSP/, 'Ruby LSP'],
  [/^rust-analyzer/, 'rust-analyzer'],
  [/^typescript-language-server/, 'TypeScript LS'],
];
function shortName(reference: string): string {
  for (const [pattern, name] of shortNames) if (pattern.test(reference)) return name;
  return reference.split(' ')[0];
}
/** The version tail the registered profile name carries after its tool name. */
function version(reference: string): string {
  const short = shortName(reference);
  const matched = shortNames.find(([pattern]) => pattern.test(reference));
  if (!matched) return '';
  return reference.replace(matched[0], '').trim() || reference.replace(short, '').trim();
}

type Row = ProfileScore & {
  name: string;
  toolVersion: string;
  /** Cases exact for Bifrost but not the reference server, and the reverse. */
  bifrostOnly: number;
  referenceOnly: number;
  bothExact: number;
};

const rows: Row[] = profiles
  .map((profile) => {
    const { shared, bifrostExact, referenceExact } = profile.strict;
    // bifrostExact and referenceExact each count "both exact" plus that side's
    // own wins, so the overlap follows from the shared denominator.
    const bothExact = Math.max(0, bifrostExact + referenceExact - shared);
    return {
      ...profile,
      name: shortName(profile.reference),
      toolVersion: version(profile.reference),
      bothExact,
      bifrostOnly: bifrostExact - bothExact,
      referenceOnly: referenceExact - bothExact,
    };
  })
  .sort((a, b) => b.bifrostOnly - a.bifrostOnly || b.strict.shared - a.strict.shared);

// The cards below detail one slice. Showing only that slice's size would make
// it read as the whole evidence base, which is the failure this page is meant
// to avoid -- so name every frozen slice and keep the tiers distinct.
const breadth = ['v1', 'v2', 'legacy']
  .map((id) => {
    const slice = slices[id];
    if (!slice) return null;
    const result = (slice.result ?? {}) as SliceResult;
    const prospective = slice.selectionRegime === 'prospective_pre_registered';
    return {
      id,
      label:
        id === 'legacy'
          ? 'Reviewed legacy core'
          : `Prospective ${id}`,
      caseCount: slice.caseCount as number,
      release: result.release ?? null,
      prospective,
      tier: prospective ? 'Preregistered' : 'Retrospective',
      detailed: id === 'legacy',
    };
  })
  .filter(Boolean) as {
  id: string;
  label: string;
  caseCount: number;
  release: string | null;
  prospective: boolean;
  tier: string;
  detailed: boolean;
}[];
const breadthTotal = breadth.reduce((sum, slice) => sum + slice.caseCount, 0);

const totalShared = rows.reduce((sum, row) => sum + row.strict.shared, 0);
const bifrostAhead = rows.filter((row) => row.bifrostOnly > row.referenceOnly).length;
const referenceAhead = rows.filter((row) => row.referenceOnly > row.bifrostOnly).length;
const level = rows.length - bifrostAhead - referenceAhead;
const behind = rows.filter((row) => row.referenceOnly > row.bifrostOnly);

// Each bar is a share of its own card's shared denominator, never of the
// widest card. Reference servers answer different populations -- 5 shared cases for gopls,
// 16 for the TypeScript server -- so a cross-card scale made 9 of 9 render at
// 56% and read as a 56% score. Bar lengths are comparable within a card, which
// is the only comparison the denominators support.
function width(value: number, shared: number): string {
  return `${(100 * value) / Math.max(1, shared)}%`;
}
---

<p class="eyebrow">
  Immutable evidence · UsageBench {published ? legacyResult.release : '(unpublished)'}
</p>

{published && rows.length > 0 ? (
  <>
    <aside class="short-answer">
      <p class="label">Short answer</p>
      <p class="verdict">
        Against ten reference language servers on the reviewed legacy core,
        Bifrost is exact on more cases than the reference server in{' '}
        <strong>{bifrostAhead}</strong>
        {' '}of {rows.length} comparisons, level in {level}, and behind in {referenceAhead}
        {behind.length > 0 ? ` (${behind.map((row) => row.name).join(', ')})` : ''}.
        Each language server is compared only on the cases it and Bifrost both
        answer, so a reference server is never charged for an operation it does
        not offer.
      </p>
      <p>
        UsageBench is <a href="https://github.com/BrokkAi">BrokkAi</a>'s own
        benchmark: we build it to measure where <a href="https://brokk.ai">Bifrost</a>
        {' '}stands against established language servers, and to keep ourselves
        honest while doing it. Every number here is generated from
        digest-bound freeze evidence we cannot edit after the fact — our own
        misses and regressions included.
      </p>
      <p class="tier-note">
        <strong>Tier:</strong> these {legacy.caseCount} cases are the
        <em> reviewed legacy core</em> — retrospectively selected from an
        analyzer-informed corpus, then re-reviewed from source alone. It is the
        broadest comparison we publish, and deliberately not a preregistered
        one. The <a href="/results/">prospective slices</a> carry
        that stronger claim over fewer languages.
      </p>
    </aside>

    <section class="breadth" aria-label="Frozen evidence breadth">
      <h2>Frozen evidence · {breadthTotal} cases</h2>
      <ul>
        {breadth.map((slice) => (
          <li class:list={['slice', slice.prospective ? 'prospective' : 'retrospective', { detailed: slice.detailed }]}>
            <p class="tier">{slice.tier}</p>
            <p class="count">{slice.caseCount}<span> cases</span></p>
            <p class="which">{slice.label}</p>
            <p class="rel">
              {slice.release ? <code>{slice.release}</code> : 'no published result'}
              {slice.detailed ? ' · detailed below' : ''}
            </p>
          </li>
        ))}
      </ul>
      <p class="note">
        Each slice keeps its own denominator and they are never pooled. The
        preregistered slices select and review sources before any analyzer runs;
        the legacy core was selected retrospectively and re-reviewed from source
        alone.
      </p>
    </section>

    <div class="references">
      {rows.map((row) => (
        <article class="reference">
          <header>
            <h3>{row.name}</h3>
            <span class="ver" title={row.reference}>{row.toolVersion}</span>
          </header>
          <div class="bars">
            <span class="who">Bifrost</span>
            <div class="track">
              <div class="fill bifrost" style={`width:${width(row.strict.bifrostExact, row.strict.shared)}`}></div>
            </div>
            <span class="num">{row.strict.bifrostExact}<small>/{row.strict.shared}</small></span>
            <span class="who">{row.name}</span>
            <div class="track">
              <div class="fill reference" style={`width:${width(row.strict.referenceExact, row.strict.shared)}`}></div>
            </div>
            <span class="num">{row.strict.referenceExact}<small>/{row.strict.shared}</small></span>
          </div>
          <dl class="split">
            <div><dt>Both exact</dt><dd>{row.bothExact}</dd></div>
            <div><dt>Bifrost only</dt><dd>{row.bifrostOnly}</dd></div>
            <div><dt>Reference only</dt><dd>{row.referenceOnly}</dd></div>
          </dl>
        </article>
      ))}
    </div>

    <p class="foot">
      Strict-contract conformance across {totalShared} shared case comparisons,
      from release <code>{legacyResult.release}</code> at revision{' '}
      <code>{(legacyResult.revision ?? '').slice(0, 12)}</code>. A case counts as
      exact only with complete token ranges, no unallowed extras, and the one
      reviewed navigation target. Disagreement is a contract result, not an
      automatic defect verdict — see the{' '}
      <a href="/results/evidence/">evidence map</a> for every hash and
      denominator.
    </p>
  </>
) : (
  <aside class="short-answer">
    <p class="label">No published comparison</p>
    <p class="verdict">
      This page renders scores only from a checksum-verified immutable release.
      None was supplied to this build, so no comparison is shown.
    </p>
    <p>
      The <a href="/results/evidence/">evidence map</a> records which
      slices have a verified result and which are still pending.
    </p>
  </aside>
)}

<style>
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.5rem;
  }
  .short-answer {
    border: 1px solid var(--sl-color-gray-5);
    border-left: 4px solid var(--sl-color-accent);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
    background: var(--sl-color-gray-7, transparent);
  }
  .short-answer .label {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
    color: var(--sl-color-gray-3);
    margin: 0 0 0.35rem;
  }
  .short-answer .verdict {
    font-size: 1.15rem;
    line-height: 1.5;
    margin: 0 0 0.75rem;
  }
  .short-answer p { margin: 0 0 0.6rem; }
  .short-answer p:last-child { margin-bottom: 0; }
  .tier-note {
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
    border-top: 1px solid var(--sl-color-gray-5);
    padding-top: 0.6rem;
  }

  .breadth { margin-bottom: 1.75rem; }
  .breadth h2 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--sl-color-gray-3);
    margin: 0 0 0.6rem;
    border: none;
  }
  .breadth ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .breadth li {
    margin: 0;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    /* The tier is carried by a border, not only by the word, so the two
       regimes stay distinct at a glance. */
    border-left-width: 4px;
  }
  .breadth li.prospective { border-left-color: var(--sl-color-accent); }
  .breadth li.retrospective { border-left-color: var(--sl-color-gray-4); }
  .breadth li.detailed { background: var(--sl-color-gray-7, transparent); }
  .breadth .tier {
    margin: 0;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--sl-color-gray-3);
  }
  .breadth .count {
    margin: 0.15rem 0 0;
    font-size: 1.4rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }
  .breadth .count span { font-size: 0.8rem; color: var(--sl-color-gray-3); }
  .breadth .which { margin: 0.1rem 0 0; font-size: 0.85rem; }
  .breadth .rel { margin: 0.25rem 0 0; font-size: 0.72rem; color: var(--sl-color-gray-3); }
  .breadth .note {
    margin: 0.7rem 0 0;
    font-size: 0.8rem;
    color: var(--sl-color-gray-2);
  }

  .references {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .reference {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    padding: 0.9rem 1rem;
  }
  /* Starlight's markdown flow adds a top margin to every sibling after the
     first. Inside these grids that left the first card taller than the rest,
     and then the first breakdown column sitting 16px above its neighbours.
     Every grid here owns its spacing through gap, so reset the children. */
  .references > .reference,
  .reference .split > div,
  .reference .bars > *,
  .breadth ul > li {
    margin: 0;
  }
  .reference header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }
  .reference h3 { font-size: 1rem; margin: 0; }
  .reference .ver {
    font-size: 0.7rem;
    color: var(--sl-color-gray-3);
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 55%;
  }
  /* One grid for both rows, so the label column sizes to the longer of the two
     names and the tracks still line up. A fixed label width wrapped the longer
     server names onto a second line and left those cards taller than the rest. */
  .bars {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.35rem 0.5rem;
  }
  .bars .who {
    font-size: 0.8rem;
    color: var(--sl-color-gray-2);
    white-space: nowrap;
  }
  .track {
    background: var(--sl-color-gray-6);
    border-radius: 0.2rem;
    height: 0.7rem;
    overflow: hidden;
  }
  .fill { height: 100%; border-radius: 0.2rem; }
  .fill.bifrost { background: var(--sl-color-accent); }
  .fill.reference { background: var(--sl-color-gray-4); }
  .bars .num {
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }
  .bars .num small { color: var(--sl-color-gray-3); }
  /* Fixed slots, so every card is the same height whatever the numbers say. */
  .reference .split {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.4rem;
    margin: 0.7rem 0 0;
    padding-top: 0.6rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }
  .reference .split div { min-width: 0; }
  .reference .split dt {
    font-size: 0.68rem;
    color: var(--sl-color-gray-3);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .reference .split dd {
    margin: 0.1rem 0 0;
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
  }
  .foot { font-size: 0.85rem; color: var(--sl-color-gray-2); }

  @media (max-width: 30rem) {
    .bars .who { font-size: 0.75rem; }
  }
</style>
